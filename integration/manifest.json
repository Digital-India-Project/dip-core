    "dip-status": {
      "expectedVersionRange": ">=0.1.0 <1.0.0",
      "relationship": "optional-service-availability-enum-consumer",
      "compatibilityStatus": "awaiting-cross-repo-verification"
    }
  },
  "capabilities": {
    "implemented": [
      "Branded domain identifiers and semver helpers",
      "Integer paise Money arithmetic and BigInt basis-point rounding",
      "Strict UTC instant and business date parsing with calendar validation",
      "Result/Option primitives and sanitized DomainError serialization",
      "Service/product definitions and deterministic GST/concession pricing",
      "Application lifecycle state machine with preconditions and optimistic concurrency",
      "Payment order, cumulative refund, and reconciliation contracts",
      "Document metadata validation, expiration checks, and checklist evaluation",
      "Versioned form schema validation with conditional visibility and prototype/ReDoS guards",
      "Identity/tenant/business/partner reference contracts",
      "Versioned domain event envelopes, audit events, and notification request contracts",
      "Automated dependency boundary check and Node.js unit/contract tests"
    ],
    "mockedOrProvisional": [
      "Synthetic domain fixtures (src/core/fixtures/syntheticFixtures.ts)",
      "Provisional DIPINDIA compatibility adapters (src/core/compatibility/dipindiaAdapters.ts)"
    ],
    "blocked": [
      "Read-only source audit of DIPINDIA repository (unavailable in this workspace)",
      "Cross-repository integration verification with dip-api, dip-ui, dip-sdk, dip-security, dip-automation",
      "Git branch/commit/PR creation (workspace snapshot lacks .git and remote credentials)"
    ],
    "untested": [
      "Live DIPINDIA golden characterization parity",
      "Real Cashfree / API Sathi / Firebase / Cloudflare adapter execution (out of scope for dip-core)"
    ]
  },
  "compatibilityStatus": "core-library-ready-for-adapter-testing; dipindia-parity-pending",
  "knownBlockers": [
    "No access to DIPINDIA or sibling repository sources in this environment to verify legacy schemas and pricing parity.",
    "No package-lock.json present for npm audit.",
    "No .git directory or GitHub remote configured for branch/PR delivery."
  ]
