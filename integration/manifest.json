  "apiContractsConsumed": {
    "httpApisConsumed": [],
    "externalSdksConsumed": [],
    "notes": "dip-core is pure and consumes no external HTTP APIs, provider SDKs, or databases."
  },
  "apiContractsProvided": {
    "httpEndpointsProvided": [],
    "domainContractModules": [
      "errors/domainError (ErrorCode, DomainError, sanitizeMetadata, serializeDomainError)",
      "common/result (Result, Option, combinators)",
      "common/identifiers (21 branded EntityPrefix IDs, SchemaVersion, semver compatibility)",
      "common/money (Money in INR paise, BigInt basis-point rounding)",
      "common/time (UtcInstant, BusinessDate, Asia/Kolkata, expiration helpers)",
      "common/pagination (PageRequest, SortSpec, FilterSpec, MetadataContract)",
      "identity/identityAndTenant (TenantContext, ActorReference, CustomerReference, BusinessReference)",
      "events/eventEnvelope (DomainEventEnvelope, AuditEventContract, NotificationRequestContract)",
      "services/catalogueAndPricing (ServiceDefinition, ProductDefinition, calculateServiceQuote)",
      "forms/formSchema (FormSchemaContract, FormSectionSchema, validateFormSchemaDefinition, validateFormSubmission)",
      "documents/documentRequirements (DocumentRequirement, DocumentRecord, evaluateDocumentChecklist)",
      "applications/applicationLifecycle (ApplicationContract, transitionApplicationState with expectedVersion)",
      "payments/paymentLifecycle (PaymentOrderContract, RefundRequestContract, reconcilePaymentOrder)",
      "partners/partnerContract (PartnerContract, OperatorAssignmentContract)",
      "compatibility/dipindiaAdapters (provisional boundary adapters pending DIPINDIA audit)"
    ],
    "sharedContractVectors": "./tests/fixtures/contract-vectors.json"
  },
  "authenticationDependencies": {
    "ownsAuthentication": false,
    "ownsAuthorizationEnforcement": false,
    "authorityRepository": "dip-security / DIPINDIA",
    "contractsProvided": [
      "ActorRole",
      "ActorReference",
      "TenantContext",
      "ErrorCode.PERMISSION_DENIED"
    ],
    "notes": "Core defines actor and tenant reference shapes only; runtime authn/authz enforcement belongs in dip-security, dip-api, and DIPINDIA."
  },
  "databaseDependencies": {
    "ownsDatabase": false,
    "ormOrDriversUsed": [],
    "authorityRepository": "DIPINDIA / dip-infrastructure",
    "notes": "Zero database, Firestore, D1, R2, or PostgreSQL imports in src/core/."
  },
  "infrastructureDependencies": {
    "cloudProviders": [],
    "deploymentTarget": "npm workspace / package artifact only (not an independently deployed service)",
    "authorityRepository": "dip-infrastructure"
  },
  "environmentVariables": [
    "VITE_APP_ENV"
  ],
  "relatedRepositories": {
    "DIPINDIA": {
      "expectedVersionRange": "unverified (source unavailable in workspace)",
      "relationship": "primary-consumer-and-functional-authority",
      "compatibilityStatus": "provisional-adapters-ready-pending-audit"
    },
    "dip-api": {
      "expectedVersionRange": ">=0.1.0 <1.0.0",
      "relationship": "consumer-for-domain-dtos-validation-and-errors",
      "compatibilityStatus": "awaiting-cross-repo-verification"
    },
    "dip-ui": {
      "expectedVersionRange": ">=0.1.0 <1.0.0",
      "relationship": "consumer-for-enums-form-schemas-and-error-codes",
      "compatibilityStatus": "awaiting-cross-repo-verification"
    },
    "dip-sdk": {
      "expectedVersionRange": ">=0.1.0 <1.0.0",
      "relationship": "consumer-for-stable-domain-types",
      "compatibilityStatus": "awaiting-cross-repo-verification"
    },
    "dip-security": {
      "expectedVersionRange": ">=0.1.0 <1.0.0",
