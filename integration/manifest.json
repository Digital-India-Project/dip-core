{
  "schemaVersion": "1.0.0",
  "repositoryName": "dip-core",
  "repositoryVersion": "0.2.0",
  "packageName": "@dip/core",
  "packagePrivate": true,
  "role": "Shared framework-independent domain contracts, schemas, and deterministic business rules",
  "runtimeRequirements": {
    "node": ">=22.0.0",
    "moduleSystem": "ESM",
    "typescript": "^5.7.3",
    "coreRuntimeDependencies": []
